# KeyStar backend configuration. Copy to .env and fill in real values.
# The server reads environment variables; load .env before `go run ./cmd/server`.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/keystar?sslmode=disable
LICENSE_HMAC_KEY=Ezsa/e3++v4BpvV/mdCyn8pVgJUCi1cvToJuwAHMm64=
HARDWARE_HMAC_KEY=zAAHOd3qtVLRguJuBfKNxj5I/xUAhPRkVw/pFJjjA7I=
ED25519_PRIVATE_KEY=V4hU4ESvjrHnRp1D8tpT53lriFGnN9OpqlY7p+Mjohw=
LICENSE_ISSUER=keystar
LICENSE_AUDIENCE=keystar-clients
PRODUCT=starloader
ADMIN_SESSION_SECRET=u7tOmCXJT3IKIB2wofFbNNXD9fmv39er9bDg36G4ugg=
# Exactly 32 bytes; rotate through a controlled data-migration procedure.
ADMIN_MFA_ENCRYPTION_KEY=2FcvZC9flHSu1p5IWmel5qVJFzMiU/vs52OtD4WzBMo=
# Secure by default. Set false only for local HTTP development.
ADMIN_COOKIE_SECURE=false

# --- Operational knobs (all optional) -------------------------------------

# Per-credential request throttle on /v1/auth/*, /v1/device/* and /v1/server/*
# (requests per minute). Default: 120.
CREDENTIAL_RATE_LIMIT=

# In-memory fallback map guard used by isolated tests. Production counters are
# shared in PostgreSQL. Default: 10000.
RATE_LIMIT_MAX_KEYS=

# Expose Prometheus metrics at GET /metrics (1 = enabled). A 32-byte minimum
# bearer token is mandatory when enabled.
ENABLE_METRICS=
METRICS_TOKEN=

# Retention in days for audit logs / security events. 0 or unset keeps data
# forever.
AUDIT_RETENTION_DAYS=
SECURITY_EVENT_RETENTION_DAYS=


